{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hermes-tailscale-probe-default",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "SCHEDULING_POLICY": "default" },
  "containers": [{
    "class_name": "NetworkProbe",
    "scheduling_policy": "default",
    "image": "./Dockerfile",
    "instance_type": "lite",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "NetworkProbe" }] },
  "exports": { "NetworkProbe": { "type": "durable-object", "storage": "sqlite" } }
}
